{
  "$schema": "https://raw.githubusercontent.com/lit/lit/main/packages/localize-tools/config.schema.json",
  "sourceLocale": "en",
  "targetLocales": ["es", "fr", "de", "pt", "nl", "it"],
  "inputFiles": ["src/**/*.js"],
  "output": {
    "mode": "runtime",
    "outputDir": "src/locales",
    "localeCodesModule": "src/locale-codes.js"
  },
  "interchange": {
    "format": "xliff",
    "xliffDir": "xliff/"
  }
}
